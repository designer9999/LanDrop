{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Android-only filesystem access for the share/save paths (content:// picker reads, Downloads/Pictures writes)",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "file-helper:allow-open-file",
    "file-helper:allow-save-to-downloads",
    "file-helper:allow-get-file-name",
    "fs:allow-read",
    "fs:allow-read-file",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPDATA/files/media_history/**"
        },
        {
          "path": "$APPDATA/files/received/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$PICTURE/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "content://**"
        },
        {
          "path": "/storage/**"
        }
      ]
    }
  ]
}
